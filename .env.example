# DineFlow settings. Copy to .env (INSTALL_AND_START does this for you). EVERYTHING here is optional:
# with nothing set DineFlow runs fully in Demo Mode with a local database file. No accounts needed.

# Port the app runs on, and the address printed in QR codes.
PORT=5173
# Leave empty to detect the laptop's Wi-Fi address automatically. Set it when using an https tunnel
# or a hosted site, e.g. https://dineflow.example.com  (never "localhost": phones cannot reach it).
PUBLIC_BASE_URL=

# Sign-in PINs for the restaurant team. Change these before using DineFlow outside a classroom demo.
STAFF_PIN=1111
KITCHEN_PIN=2222
ADMIN_PIN=9999

# Optional: Microsoft Power Automate "When an HTTP request is received" URL. DineFlow posts alerts
# (long queue, failed payment, delayed dish, no-show) to it. Leave empty to turn this off.
POWER_AUTOMATE_WEBHOOK_URL=

# Optional: where the local database file lives (default: ./data)
# DATA_DIR=
